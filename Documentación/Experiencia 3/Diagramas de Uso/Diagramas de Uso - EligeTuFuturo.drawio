  <diagram id="oqWC_it7cEkSyo4CDud8" name="Diag. Dashboard">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml \&quot;Diagrama de Uso - Dashboard\&quot;\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\n\n&#39; ============================================\n&#39; COLORES\n&#39; ============================================\nskinparam usecaseBackgroundColor #D4E6F1\nskinparam usecaseBorderColor #1A5276\nskinparam usecaseBackgroundColor #FADBD8\nskinparam usecaseBorderColor #78281F\n\n&#39; ============================================\n&#39; ACTORES\n&#39; ============================================\nactor \&quot;Estudiante\&quot; as Estudiante\nactor \&quot;Administrador\&quot; as Admin\n\n&#39; ============================================\n&#39; PORTAL ELIGE TU FUTURO\n&#39; ============================================\nrectangle \&quot;Dashboard\&quot; {\n  \n  usecase \&quot;Visualizar Dashboard\&quot; as DASH\n  usecase \&quot;Consultar Indicadores\&quot; as IND\n  usecase \&quot;Ver Estadísticas por Carrera\&quot; as EST_CARR\n  usecase \&quot;Ver Estadísticas por Sexo\&quot; as EST_SEX\n  usecase \&quot;Ver Estadísticas por Sede\&quot; as EST_SED\n  usecase \&quot;Actualizar Datos\&quot; as ACT\n  usecase \&quot;Gestionar Estadísticas\&quot; as GEST\n  \n}\n\n&#39; ============================================\n&#39; RELACIONES DEL ESTUDIANTE\n&#39; ============================================\nEstudiante --&gt; DASH\nEstudiante --&gt; IND\n\nDASH ..&gt; IND : &lt;&lt;include&gt;&gt;\n\nIND ..&gt; EST_CARR : &lt;&lt;include&gt;&gt;\nIND ..&gt; EST_SEX : &lt;&lt;include&gt;&gt;\nIND ..&gt; EST_SED : &lt;&lt;include&gt;&gt;\n\n&#39; ============================================\n&#39; RELACIONES DEL ADMINISTRADOR\n&#39; ============================================\nAdmin --&gt; DASH\nAdmin --&gt; IND\nAdmin --&gt; ACT\nAdmin --&gt; GEST\n\nDASH ..&gt; IND : &lt;&lt;include&gt;&gt;\n\nIND ..&gt; EST_CARR : &lt;&lt;include&gt;&gt;\nIND ..&gt; EST_SEX : &lt;&lt;include&gt;&gt;\nIND ..&gt; EST_SED : &lt;&lt;include&gt;&gt;\n\nACT ..&gt; DASH : &lt;&lt;extend&gt;&gt;\nGEST ..&gt; ACT : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="vNJHKBJzT8fsr49LxTvn-1">
