        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\n\nactor Estudiante\nactor Administrador\n\nrectangle \&quot;Elige Tu Futuro\&quot; {\n\n    package \&quot;Acceso\&quot; {\n        usecase \&quot;Registrarse\&quot; as UC_Register\n        usecase \&quot;Recuperar\\nContraseña\&quot; as UC_Recovery\n        usecase \&quot;Iniciar\\nSesión\&quot; as UC_Login\n        usecase \&quot;Cerrar\\nSesión\&quot; as UC_Logout\n    }\n\n    package \&quot;Acceso Estudiante\&quot; {\n\n        usecase \&quot;Acceder Módulos\\nEstudiante\&quot; as UC_StudentAccess\n\n        usecase \&quot;Visualizar Dashboard\&quot; as UC_Dashboard\n        usecase \&quot;Gestionar Perfil\&quot; as UC_Profile\n        usecase \&quot;Buscar Carrera\&quot; as UC_Search\n        usecase \&quot;Comparar Carreras\&quot; as UC_Compare\n        usecase \&quot;Realizar Test Vocacional\&quot; as UC_Test\n        usecase \&quot;Consultar Mapa Educativo\&quot; as UC_Map\n\n        usecase \&quot;Visualizar Ficha Carrera\&quot; as UC_Detail\n        usecase \&quot;Ver Resultado Test\&quot; as UC_Result\n    }\n\n    package \&quot;Acceso Administrador\&quot; {\n\n        usecase \&quot;Acceder\\nAdministración\&quot; as UC_AdminAccess\n\n        usecase \&quot;Administrar Usuarios\&quot; as UC_Users\n        usecase \&quot;Administrar Estadísticas\&quot; as UC_Stats\n    }\n}\n\nEstudiante --&gt; UC_Register\nEstudiante --&gt; UC_Recovery\nEstudiante --&gt; UC_Login\nEstudiante --&gt; UC_Logout\n\nAdministrador --&gt; UC_Register\nAdministrador --&gt; UC_Recovery\nAdministrador --&gt; UC_Login\nAdministrador --&gt; UC_Logout\n\nEstudiante --&gt; UC_StudentAccess\nAdministrador --&gt; UC_AdminAccess\n\nUC_StudentAccess .&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_AdminAccess .&gt; UC_Login : &lt;&lt;include&gt;&gt;\n\nUC_Dashboard .&gt; UC_StudentAccess : &lt;&lt;include&gt;&gt;\nUC_Profile .&gt; UC_StudentAccess : &lt;&lt;include&gt;&gt;\nUC_Search .&gt; UC_StudentAccess : &lt;&lt;include&gt;&gt;\nUC_Compare .&gt; UC_StudentAccess : &lt;&lt;include&gt;&gt;\nUC_Test .&gt; UC_StudentAccess : &lt;&lt;include&gt;&gt;\nUC_Map .&gt; UC_StudentAccess : &lt;&lt;include&gt;&gt;\n\nUC_Users .&gt; UC_AdminAccess : &lt;&lt;include&gt;&gt;\nUC_Stats .&gt; UC_AdminAccess : &lt;&lt;include&gt;&gt;\n\nUC_Search .&gt; UC_Detail : &lt;&lt;include&gt;&gt;\nUC_Test .&gt; UC_Result : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="TZPSctAOdjaAtjXgKVtj-7">
