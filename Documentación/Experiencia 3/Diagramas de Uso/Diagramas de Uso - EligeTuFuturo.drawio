        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\nskinparam packageStyle rectangle\n\nactor Estudiante\nactor Administrador\n\nrectangle \&quot;Elige Tu Futuro\&quot; {\n\n    package \&quot;Acceso\&quot; {\n\n        usecase \&quot;Registrarse\&quot; as UC_Register\n        usecase \&quot;Recuperar\\nContraseña\&quot; as UC_Recovery\n        usecase \&quot;Iniciar\\nSesión\&quot; as UC_Login\n        usecase \&quot;Cerrar\\nSesión\&quot; as UC_Logout\n\n    }\n\n    package \&quot;Acceso Estudiante\&quot; {\n\n        usecase \&quot;Acceder a\\nMódulos Estudiante\&quot; as UC_StudentAccess\n\n        usecase \&quot;Gestionar Perfil\&quot; as UC_Profile\n        usecase \&quot;Visualizar Dashboard\&quot; as UC_Dashboard\n        usecase \&quot;Buscar Carrera\&quot; as UC_Search\n        usecase \&quot;Visualizar Ficha\\nCarrera\&quot; as UC_Detail\n        usecase \&quot;Comparar Carreras\&quot; as UC_Compare\n        usecase \&quot;Realizar Test\\nVocacional\&quot; as UC_Test\n        usecase \&quot;Ver Resultado\\nTest\&quot; as UC_Result\n        usecase \&quot;Consultar Mapa\\nEducativo\&quot; as UC_Map\n    }\n\n    package \&quot;Acceso Administrador\&quot; {\n\n        usecase \&quot;Acceder a\\nAdministración\&quot; as UC_AdminAccess\n\n        usecase \&quot;Administrar Usuarios\&quot; as UC_Users\n        usecase \&quot;Administrar Estadísticas\&quot; as UC_Stats\n    }\n}\n\n&#39;====================\n&#39; Acceso público\n&#39;====================\n\nEstudiante --&gt; UC_Register\nEstudiante --&gt; UC_Recovery\n\nAdministrador --&gt; UC_Register\nAdministrador --&gt; UC_Recovery\n\nEstudiante --&gt; UC_Login\nAdministrador --&gt; UC_Login\n\n&#39;====================\n&#39; Punto intermedio\n&#39;====================\n\nEstudiante --&gt; UC_StudentAccess\nAdministrador --&gt; UC_AdminAccess\n\nUC_StudentAccess .&gt; UC_Login : &lt;&lt;include&gt;&gt;\nUC_AdminAccess .&gt; UC_Login : &lt;&lt;include&gt;&gt;\n\n&#39;====================\n&#39; Estudiante\n&#39;====================\n\nUC_StudentAccess .&gt; UC_Profile : &lt;&lt;include&gt;&gt;\nUC_StudentAccess .&gt; UC_Dashboard : &lt;&lt;include&gt;&gt;\nUC_StudentAccess .&gt; UC_Search : &lt;&lt;include&gt;&gt;\nUC_StudentAccess .&gt; UC_Compare : &lt;&lt;include&gt;&gt;\nUC_StudentAccess .&gt; UC_Test : &lt;&lt;include&gt;&gt;\nUC_StudentAccess .&gt; UC_Map : &lt;&lt;include&gt;&gt;\nUC_StudentAccess .&gt; UC_Logout : &lt;&lt;include&gt;&gt;\n\n&#39;====================\n&#39; Administrador\n&#39;====================\n\nUC_AdminAccess .&gt; UC_Users : &lt;&lt;include&gt;&gt;\nUC_AdminAccess .&gt; UC_Stats : &lt;&lt;include&gt;&gt;\nUC_AdminAccess .&gt; UC_Logout : &lt;&lt;include&gt;&gt;\n\n&#39;====================\n&#39; Relaciones internas\n&#39;====================\n\nUC_Search .&gt; UC_Detail : &lt;&lt;include&gt;&gt;\nUC_Test .&gt; UC_Result : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="TZPSctAOdjaAtjXgKVtj-6">
