      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml \&quot;Diagrama de Uso - Buscador de Carreras\&quot;\nleft to right direction\nskinparam packageStyle rectangle\nskinparam actorStyle awesome\nskinparam usecase {\n  BackgroundColor #D4E6F1\n  BorderColor #1A5276\n  FontStyle bold\n}\n\n&#39; ============================================\n&#39; ACTOR\n&#39; ============================================\nactor \&quot;Estudiante\&quot; as Estudiante\n\n&#39; ============================================\n&#39; PORTAL ELIGE TU FUTURO (Recuadro principal)\n&#39; ============================================\nrectangle \&quot;Portal Elige tu Futuro\&quot; {\n  \n  &#39; ============================================\n  &#39; BUSCADOR DE CARRERAS (Recuadro interno)\n  &#39; ============================================\n  rectangle \&quot;Buscador de Carreras\&quot; {\n    \n    usecase \&quot;Buscar Carrera\&quot; as BUS\n    usecase \&quot;Filtrar por Región\&quot; as FIL_REG\n    usecase \&quot;Filtrar por Institución\&quot; as FIL_INST\n    usecase \&quot;Filtrar por Sede\&quot; as FIL_SEDE\n    usecase \&quot;Filtrar por Carrera\&quot; as FIL_CARR\n    usecase \&quot;Visualizar Resultados\&quot; as VIS_RES\n    usecase \&quot;Ver Ficha Completa\&quot; as FICHA\n    usecase \&quot;Ver Información General\&quot; as INFO_GEN\n    usecase \&quot;Ver Información Financiera\&quot; as INFO_FIN\n    usecase \&quot;Ver Proyección Laboral\&quot; as PROY_LAB\n    usecase \&quot;Ver Malla Curricular\&quot; as MALLA\n    usecase \&quot;Visitar Sitio Oficial\&quot; as SITIO\n    \n  }\n  \n}\n\n&#39; ============================================\n&#39; RELACIONES\n&#39; ============================================\nEstudiante --&gt; BUS\n\nBUS ..&gt; FIL_REG : &lt;&lt;include&gt;&gt;\nBUS ..&gt; FIL_INST : &lt;&lt;include&gt;&gt;\nBUS ..&gt; FIL_SEDE : &lt;&lt;include&gt;&gt;\nBUS ..&gt; FIL_CARR : &lt;&lt;include&gt;&gt;\nBUS ..&gt; VIS_RES : &lt;&lt;include&gt;&gt;\n\nVIS_RES ..&gt; FICHA : &lt;&lt;include&gt;&gt;\n\nFICHA ..&gt; INFO_GEN : &lt;&lt;include&gt;&gt;\nFICHA ..&gt; INFO_FIN : &lt;&lt;include&gt;&gt;\nFICHA ..&gt; PROY_LAB : &lt;&lt;include&gt;&gt;\nFICHA ..&gt; MALLA : &lt;&lt;include&gt;&gt;\nFICHA ..&gt; SITIO : &lt;&lt;include&gt;&gt;\n\n&#39; ============================================\n&#39; NOTA\n&#39; ============================================\nnote right of BUS\n  **Búsqueda por:**\n  • Palabra clave\n  • Área de conocimiento\n  • Nombre de carrera\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="Is0xQaF6_oesehhnyFTs-5">
