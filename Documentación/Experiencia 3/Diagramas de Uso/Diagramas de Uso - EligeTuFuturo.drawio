        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nleft to right direction\nskinparam packageStyle rectangle\n\nactor Estudiante\nactor Administrador\n\nrectangle \&quot;Elige Tu Futuro\&quot; {\n\n    package \&quot;Acceso\&quot; {\n\n        usecase \&quot;Registrarse\&quot; as UC_Register\n        usecase \&quot;Recuperar\\nContraseña\&quot; as UC_Recovery\n        usecase \&quot;Iniciar\\nSesión\&quot; as UC_Login\n        usecase \&quot;Cerrar\\nSesión\&quot; as UC_Logout\n\n    }\n\n    package \&quot;Módulos del Estudiante\&quot; {\n\n        usecase \&quot;Gestionar\\nPerfil\&quot; as UC_Profile\n\n        usecase \&quot;Visualizar\\nDashboard\&quot; as UC_Dashboard\n\n        usecase \&quot;Buscar\\nCarrera\&quot; as UC_Search\n\n        usecase \&quot;Visualizar\\nFicha Carrera\&quot; as UC_Detail\n\n        usecase \&quot;Comparar\\nCarreras\&quot; as UC_Compare\n\n        usecase \&quot;Realizar Test\\nVocacional\&quot; as UC_Test\n\n        usecase \&quot;Ver Resultado\\nTest\&quot; as UC_Result\n\n        usecase \&quot;Consultar Mapa\\nEducativo\&quot; as UC_Map\n    }\n\n    package \&quot;Administración\&quot; {\n\n        usecase \&quot;Administrar\\nUsuarios\&quot; as UC_Users\n\n        usecase \&quot;Administrar\\nEstadísticas\&quot; as UC_Stats\n\n    }\n}\n\n&#39;=========================\n&#39; ACCESO\n&#39;=========================\n\nEstudiante --&gt; UC_Register\nEstudiante --&gt; UC_Recovery\nEstudiante --&gt; UC_Login\n\nAdministrador --&gt; UC_Register\nAdministrador --&gt; UC_Recovery\nAdministrador --&gt; UC_Login\n\nEstudiante --&gt; UC_Logout\nAdministrador --&gt; UC_Logout\n\n&#39;=========================\n&#39; ESTUDIANTE\n&#39; (Precondición: Sesión iniciada)\n&#39;=========================\n\nEstudiante --&gt; UC_Profile\nEstudiante --&gt; UC_Dashboard\nEstudiante --&gt; UC_Search\nEstudiante --&gt; UC_Compare\nEstudiante --&gt; UC_Test\nEstudiante --&gt; UC_Map\n\n&#39;=========================\n&#39; ADMINISTRADOR\n&#39; (Precondición: Sesión iniciada)\n&#39;=========================\n\nAdministrador --&gt; UC_Users\nAdministrador --&gt; UC_Stats\n\n&#39;=========================\n&#39; RELACIONES ENTRE CASOS\n&#39;=========================\n\nUC_Search .&gt; UC_Detail : &lt;&lt;include&gt;&gt;\n\nUC_Test .&gt; UC_Result : &lt;&lt;include&gt;&gt;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="TZPSctAOdjaAtjXgKVtj-4">
